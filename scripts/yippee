#!/usr/bin/env bash

set -eo pipefail

# get sudo perms
if [ "$EUID" != 0 ]; then
    sudo "$0" "$@"
    exit $?
fi

# echo!
echo -e "\033[1m\033[7mStarting system updates...\033[0m"

usern="$(logname)"
echo "Detected username: $usern"

echo "Updating Zsh plugins..."
sudo -u "$usern" zsh -c "source ~/.local/share/znaprepos/znap/znap.zsh && znap pull"

echo "Updating tmux plugins..."
sudo -u "$usern" zsh -c "~/.tmux/plugins/tpm/bin/update_plugins all"

echo "Updating Distrobox Zypper..."
sudo -u "$usern" distrobox enter dregsbox -- sudo zypper dup -y
echo "Updating Distrobox pipx packages..."
sudo -u "$usern" distrobox enter dregsbox -- pipx upgrade-all

echo "Updating Flatpak apps..."
sudo flatpak upgrade -y

echo "Updating system Nixpkgs..."
sudo nh os boot "path:///home/jason/dotfiles/nixos" -u -R
echo "Garbage collecting Nix..."
sudo nix-collect-garbage --delete-older-than 25d
echo "Optimising Nix store..."
sudo nix store optimise

echo "Writing to update history file..."
date >> ~/.local/share/.yippee_history

zenity --notification --text "Yippee: Finished updating.\nAutomatically rebooting in 30 seconds..."
read -p "Press Enter to reboot (auto-rebooting in 30 seconds) " -r -t 30 || :
echo "Rebooting..."
sudo systemctl reboot

