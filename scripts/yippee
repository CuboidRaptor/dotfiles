#!/usr/bin/env bash

set -eo pipefail

# don't update other stuff if bootstrapping
bootstrap_flag=false
while getopts "b" flag ; do
    case "$flag" in
        b) # Bootstrap instead of updating, skip some tasks
            bootstrap_flag=true
            ;;
        ?)
            printf "Unrecognized option. Use \`-b\` to bootstrap. Use none to update."
            exit 1
            ;;
    esac
done

# get sudo perms
if [ "$EUID" != 0 ]; then
    sudo "$0" "$@"
    exit $?
fi

function msg {
    main_string="$1"
    shift
    printf "\033[1m\033[7m$main_string\033[0m\n" "$@"
}

# msg!
msg "Starting system updates..."

usern="$(logname)"
msg "Detected username: %s" "$usern"

msg "Updating system packages..."
sudo dnf upgrade --refresh

if [ "$bootstrap_flag" = false ] ; then
    msg "Updating Flatpak apps..."
    sudo -u "$usern" flatpak upgrade -y

    msg "Updating Gear Lever AppImages..."
    sudo -u "$usern" flatpak run it.mijorus.gearlever --update --all -y

    msg "Updating Neovim plugins..."
    sudo -u "$usern" nvim --headless "+Lazy! sync" +qa

    msg "Updating Zsh plugins..."
    sudo -u "$usern" zsh -c "source ~/.local/share/znaprepos/znap/znap.zsh && znap pull"

    msg "Updating tmux plugins..."
    sudo -u "$usern" bash -c "~/.tmux/plugins/tpm/bin/update_plugins all"

    msg "Emptying trashes..."
    sudo -u "$usern" trash-empty 60 -f
    sudo trash-empty 60 -f
fi

msg "Updating local appcache..."
sudo -u "$usern" bash -c 'wget "https://vencord.dev/download/vesktop/amd64/rpm" \
    -O "~/dotfiles/ansible/appcache/vesktop-latest.rpm"'
sudo -u "$usern" bash -c 'wget "https://www.tx16wx.com/download/tx16wx-software-sampler-3-linux-x64-redhat-2/?wpdmdl=19517" \
    -O "$HOME/dotfiles/ansible/appcache/tx16wx-latest.rpm"'

msg "Ensuring dotfiles are linked..."
sudo -u "$usern" bash -c "~/dotfiles/link.py"

msg "Running Ansible playbook..."
# this is a script in ~/dotfiles/scripts
sap

msg "Writing to update history file..."
sudo -u "$usern" bash -c "date >> ~/.local/share/.yippee_history"

msg "Waiting for akmods to finish building..."
sudo akmods --force

sudo -u "$usern" DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/"$(id -u "$usern")"/bus \
    notify-send "Yippee: Finished updating/bootstrapping." "Automatically rebooting in 30 seconds."
read -p "Press Enter to reboot (auto-rebooting in 30 seconds) " -r -t 30 || :
msg "Rebooting..."
sudo systemctl reboot

