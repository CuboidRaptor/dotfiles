#!/usr/bin/env python3

# this script checks if ~/.config/home-manager/nvidia.nix contains the same driver version as system
# if not, it auto-updates the config to have the right one

import subprocess
import re
import json

from pathlib import Path

nvidia_smi_result = subprocess.run(["nvidia-smi", "--query-gpu=driver_version", "--format=csv,noheader"], stdout=subprocess.PIPE)
driver_version = nvidia_smi_result.stdout.decode("utf-8").split("\n")[0]
print(f"nvidia-smi driver version {driver_version}")

version_regex = re.compile(r"version = \"(.*?)\"")

with open(Path.home() / ".config/home-manager/nvidia.nix", "r") as f:
    glnix_file = f.read()

nix_driver_version = version_regex.search(glnix_file)
assert nix_driver_version != None
nix_driver_version = nix_driver_version.group(1)
print(f"nvidia.nix driver version {nix_driver_version}")

if driver_version != nix_driver_version:
    print("Fetching new driver file...")
    nix_prefetch_result = subprocess.run(
        ["nix", "store", "prefetch-file", "--json", "--hash-type", "sha256",
            f"https://download.nvidia.com/XFree86/Linux-x86_64/{driver_version}/NVIDIA-Linux-x86_64-{driver_version}.run"],
        stdout=subprocess.PIPE
    )
    driver_hash = json.loads(nix_prefetch_result.stdout.decode("utf-8"))["hash"]

    print(f"Calculated hash {driver_hash}")
    
    generated_glnix = """# Generated by check-nix-nvidia script, do not modify
{ config, pkgs, ... }:

{
  nixpkgs.config.nvidia.acceptLicense = true;
  targets.genericLinux.gpu = {
    enable = true;
    nvidia = {
      enable = true;
      version = \"""" + driver_version + """\";
      sha256 = \"""" + driver_hash + """\";
    };
  };
}
"""
    with open(Path.home() / ".config/home-manager/nvidia.nix", "w") as f:
        f.write(generated_glnix)

    print("Generated nvidia.nix")
    print("Now run `home-manager switch`")

else:
    print("Versions are equal")