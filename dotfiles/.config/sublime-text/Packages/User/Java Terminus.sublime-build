{
    "target": "terminus_exec",
    "cancel": "terminus_cancel_build",
    "linux": {
        "shell_cmd": "javac \"${file}\" -d \"/var/tmp\" && cd \"/var/tmp\" && java \"${file_base_name}\" ; rm -f \"/var/tmp/${file_base_name}.class\""
    },
    "windows": {
        "shell_cmd": "javac \"${file}\" -d \"%TEMP%\" && cd \"%TEMP%\" && java \"${file_base_name}\" ; del /f /q \"%TEMP%/${file_base_name}.class\""
    },
    "osx": {
        "shell_cmd": "javac \"${file}\" -d \"/var/tmp\" && cd \"/var/tmp\" && java \"${file_base_name}\" ; rm -f \"/var/tmp/${file_base_name}.class\""
    },
    "working_dir": "$file_path",
    "selector": "source.java",
    "auto_close": false,
    "focus": true
}