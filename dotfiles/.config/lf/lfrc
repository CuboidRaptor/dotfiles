# Edit config and reload automatically
cmd edit-config ${{
    $EDITOR ~/.config/lf/lfrc
    lf -remote "send $id source ~/.config/lf/lfrc"
}}

map C edit-config

# Draw box!
set drawbox
set roundbox

set ifs "\n"
set hidden
set icons
set relativenumber
set scrolloff 10

# set ratios and info
set ratios 1:5:2
set info size:time
set dircounts
set watch

# enable mouse, because I can
set mouse

# follow symlinks
cmd follow-link %{{
  lf -remote "send $id select \"$(readlink -- "$f" | sed 's/\\/\\\\/g;s/"/\\"/g')\""
}}

map gl follow-link

# go to next file (not directory)
map gf :set dironly true; bottom; set dironly false; down

# create is a bash function in .bash_aliases
map a push %create<space>

# trash-cli
map x %trash-put -- $fx
map X $trash-restore

# touch
map T $touch $fx

# invert-below is cool
map V invert-below

# preview path annoys me greatly
set promptfmt "\033[32;1m%u@%h\033[0m:\033[34;1m%d\033[0m\033[1m"

# yank filename
map Y $echo "$f"|xclip -sel c -i

# set sorting
set sortby name
setlocal ~/Downloads sortby time
setlocal ~/Downloads reverse
setlocal ~/Downloads dirfirst false
setlocal ~/DownloadsArchive sortby time
setlocal ~/DownloadsArchive reverse
setlocal ~/DownloadsArchive dirfirst false

# allow temp z mark
set tempmarks z

# go to first non-hidden file
map D push zhggzh
