export PATH="$PATH:\
$HOME/dotfiles/scripts:\
$HOME/.local/bin:\
$HOME/.cargo/bin:\
$HOME/bin"

export VISUAL="nvim"
export EDITOR="$VISUAL"

export WINEESYNC=1
export WINEFSYNC=1

if [ -f ~/.nix-profile/etc/profile.d/hm-session-vars.sh ]
then
    source ~/.nix-profile/etc/profile.d/hm-session-vars.sh
fi