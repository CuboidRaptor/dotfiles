# dnf aliases, I'm lazy
alias sdi="sudo dnf install"
alias sdr="sudo dnf remove"
alias dse="dnf search"
alias dli="dnf list --installed"
alias dlim="dnf repoquery --userinstalled"

# ansible localhost run current playbook
alias sap="sudo ansible-playbook --connection=local --inventory=127.0.0.1, ~/dotfiles/ansible/playbook.yaml -v"

## rebuild and switch using nh
#FLAKEPATH="path:///home/jason/dotfiles/nixos"
#alias nsw="sudo nh os switch \"$FLAKEPATH\" -R"
#alias nbt="sudo nh os boot \"$FLAKEPATH\" -R"
#alias nsetboot="sudo /run/current-system/bin/switch-to-configuration boot"
#alias nli="nix-store --query --requisites /run/current-system"

# nix stuff
alias nix-alien="nix run \"github:thiagokokada/nix-alien#nix-alien\""
alias nix-alien-ld="nix run \"github:thiagokokada/nix-alien#nix-alien-ld\""
alias nix-alien-find-libs="nix run \"github:thiagokokada/nix-alien#nix-alien-find-libs\""
alias nixGL="nix run --impure github:nix-community/nixGL" # requires nixos-unstable! check repo for more

# distrobox quick enter command
alias dbox="distrobox enter dregsbox"

# last time system was upgraded
alias lasty="cat ~/.local/share/.yippee_history | tail -n 3"

alias dreset="git checkout -- dconf.ini && dconf load / < dconf.ini"

# I use this a lot
alias lg="lazygit"

# neofetch!
alias neofetch="fastfetch -c neofetch"

# better alternatives
# (remember that if `x` is aliased to `y`, `\x` will still use the original x (i.e. \ls))
alias l="eza -a --color=always --icons=always --group-directories-first"
#alias cat="bat" # probably shouldn't do this
#alias vim="nvim" # unneeded because of nixos

# add color to ls
alias ls="ls --color=auto"

# make tree show hiddens and ignore .git
alias tree="tree -a -I '.git'"

alias retrack="git rm -r --cached . && git add ."

# show sizes in MB
alias free="free -m"

# strip metadata from image
alias imgstrip="mogrify -strip"

# better fd
alias fd="fd -u --exclude .git"

fzf-cd-recursively-widget () {
    FZF_ALT_C_COMMAND="{ fd -u --exclude .git -t d && find -mindepth 1 -maxdepth 1 -type l -xtype d -printf '%P/\n'; }" \
        zle fzf-cd-widget
}
zle -N fzf-cd-recursively-widget
bindkey "^[f" fzf-cd-recursively-widget

# server for nvrw (this is in a function because it has to or else tmux gets angry)
# (and nvrw is a file because git edit and stuff)
nvrws () {
    nvim --listen "$HOME/.cache/nvim/nvim-tmux-session-$(tmux display-message -p '#S').pipe"
}
