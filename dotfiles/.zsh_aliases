#!/usr/bin/env zsh
# dnf aliases, I'm lazy
alias dli="dnf list --installed"
alias dlim="dnf repoquery --userinstalled"

# last time system was upgraded
alias lastupd="cat ~/.local/share/updscr_history | tail -n 5"

alias sap="sudo ansible-playbook --connection=local --inventory=127.0.0.1, ~/dotfiles/ansible/playbook.yaml -v"

# Reset changes to dconf in dotfiles repo and then write those to database
dreset () {
    (
        cd ~/dotfiles/dconf || return
        git checkout -- ./
        dconf load /org/cinnamon/ < cinnamon.dconf.ini
        dconf load /org/nemo/ < nemo.dconf.ini
        dconf load /org/gtk/ < gtk.dconf.ini
        dconf load /org/gnome/desktop/ < gnome-desktop.dconf.ini
    )
}

# neofetch!
alias neofetch="fastfetch -c neofetch"

# better alternatives
# (remember that if `x` is aliased to `y`, `\x` will still use the original x (i.e. \ls))
alias ls="eza -a --icons=auto --group-directories-first"
alias lsr="eza -a --icons=auto --sort newest"

# Retrack files that may have been ignored in `.gitignore`
alias retrack="git rm -r --cached . && git add ."

# make fd show hiddens and ignore .git and node_modules
alias fd="fd -u --exclude .git --exclude node_modules"
