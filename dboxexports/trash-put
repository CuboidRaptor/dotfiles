#!/bin/sh
# distrobox_binary
# name: dregsbox
if [ -z "${CONTAINER_ID}" ]; then
	exec "/run/current-system/sw/bin/distrobox-enter"  -n dregsbox  --  '/home/jason/.local/share/pipx/venvs/trash-cli/bin/trash-put'  "$@"
elif [ -n "${CONTAINER_ID}" ] && [ "${CONTAINER_ID}" != "dregsbox" ]; then
	exec distrobox-host-exec '/home/jason/dotfiles/dboxexports/trash-put' "$@"
else
	exec '/home/jason/.local/share/pipx/venvs/trash-cli/bin/trash-put' "$@"
fi
